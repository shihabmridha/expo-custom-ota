# ---------------------------------------------------------------------------
# expo-custom-ota backend environment
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Public origin of this server. Baked into signed manifests as the asset URL
# prefix, so changing it AFTER publishing invalidates existing manifests.
OTA_PUBLIC_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Set true when the server sits behind a reverse proxy (nginx, the dashboard
# container, a load balancer). Reads client IPs from X-Forwarded-For for rate
# limiting instead of the socket address.
TRUST_PROXY=false

# --- Database -------------------------------------------------------------
# Local / persistent SQLite database via Bun native bun:sqlite.
DATABASE_URL=file:./ota.db

# --- Object storage -------------------------------------------------------
STORAGE_LOCAL_DIR=./.storage

# --- Auth -----------------------------------------------------------------
# Min 32 chars. Generate with: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=168

# --- Signing --------------------------------------------------------------
# Directory holding per-application RSA private keys. Never inside the repo in
# production — mount a secret volume (e.g. /run/secrets/signing).
SIGNING_KEYS_DIRECTORY=./.signing-keys

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_BYTES=524288000
MAX_EXTRACTED_BYTES=1073741824
MAX_ARCHIVE_ENTRIES=5000
MAX_COMPRESSION_RATIO=100

# --- Device tracking --------------------------------------------------------
# One row per install, keyed on the EAS-Client-ID every expo-updates client
# sends, plus an event when an install is served an update and when it confirms
# it is running one. Set false to store no device identifiers at all — the
# anonymous counters in usage_daily are unaffected. See D16 in docs/decisions.md.
DEVICE_TRACKING_ENABLED=true
# Age at which `bun run prune:devices --apply` drops rows. 0 = keep forever.
DEVICE_TRACKING_RETENTION_DAYS=90

# --- Dashboard --------------------------------------------------------------
# Absolute path to the built dashboard (dashboard/dist). Unset means the
# backend is API-only — this is unset in the Docker Compose topology, where
# nginx serves the SPA instead. Only set this if you run the backend
# standalone and want it to also serve the dashboard.
# DASHBOARD_DIST=/absolute/path/to/dashboard/dist
