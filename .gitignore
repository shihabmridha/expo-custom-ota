node_modules/
dist/
build/
*.tsbuildinfo

# Local dev database (libSQL file mode)
*.db
*.db-journal
*.db-wal
*.db-shm

# Local asset storage driver output
.storage/

# Signing material — private keys must never be committed
.signing-keys/
*.pem
!**/test/**/*.pem
!**/tests/**/*.pem
# The e2e app's code signing certificate is PUBLIC and must be committed — it is
# embedded in the binary and is what verification checks against. The private
# key it pairs with never leaves the server.
!e2e/expo-test-app/certs/*.pem

# Env
.env
.env.*
!.env.example

# Temp upload staging
.tmp/

.DS_Store
Thumbs.db

# The e2e Expo app is built on demand, not part of the Bun workspace.
e2e/expo-test-app/node_modules/
e2e/expo-test-app/dist/
e2e/expo-test-app/android/
e2e/expo-test-app/ios/
e2e/expo-test-app/update.zip
e2e/expo-test-app/.expo/
